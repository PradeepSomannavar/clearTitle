# ============================================================
#  Property OCR — Environment Variables
#  Copy this file to .env and fill in your API keys.
#  The .env file is git-ignored and never committed.
# ============================================================

# ── External API Keys (REQUIRED — get from the provider) ──
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Security keys ────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── Google OAuth (optional — enables "Continue with Google") ──
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:8000/login

# ── MySQL ────────────────────────────────────────────────────
# These defaults work out-of-the-box with Docker Compose.
# Only change if you are connecting to an external MySQL server.
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=property_user
MYSQL_PASSWORD=property_pass_123
MYSQL_DATABASE=property_ocr_v2

# ── Redis ────────────────────────────────────────────────────
# Works out-of-the-box with Docker Compose. Do not change.
REDIS_URL=redis://redis:6379/0
