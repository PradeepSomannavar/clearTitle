# FASTAPI_URL: Where the clearTitle FastAPI backend lives.
# In `npm run dev`, Vite proxies /api, /auth, /health and /static to this URL
# (read via dotenv in server.ts). Defaults to http://localhost:8000.
# In the Docker deployment the SPA is served by FastAPI itself — this file
# is not used there.
FASTAPI_URL="http://localhost:8000"
